{
  "name": "chordz",
  "private": true,
  "version": "0.1.0",
  "description": "A musician's notebook for composing, storing, and performing songs with chords and backing tracks.",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "vite",
    "electron:dev": "vite",
    "electron:build": "tsc -b && vite build && electron-builder"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@singz/ui": "file:../singz-ui",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "studio.chordz.app",
    "productName": "ChordZ",
    "directories": { "buildResources": "build" },
    "files": ["dist/**", "dist-electron/**"],
    "mac": { "category": "public.app-category.music", "target": "dmg" }
  }
}
