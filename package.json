{
  "name": "chordz",
  "private": true,
  "version": "0.1.0",
  "description": "A musician's notebook for composing, storing, and performing songs with chords and backing tracks.",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "vite",
    "electron:dev": "vite",
    "electron:build": "npm run dist",
    "typecheck": "tsc -b",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "dist": "node scripts/dist.cjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/martian-mono": "5.3.0",
    "@singz/ui": "file:vendor/singz-ui-1.8.2.tgz",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vite-plugin-electron": "1.1.1",
    "vite-plugin-electron-renderer": "1.0.0"
  },
  "allowScripts": {
    "electron@43.4.0": true
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "author": "lexasoft <lexasoft@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/lexasoft123/ChordZ.git"
  },
  "homepage": "https://github.com/lexasoft123/ChordZ#readme",
  "bugs": {
    "url": "https://github.com/lexasoft123/ChordZ/issues"
  }
}
