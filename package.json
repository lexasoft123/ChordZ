{
  "name": "chordz",
  "private": true,
  "version": "0.1.0",
  "description": "A musician's notebook for composing, storing, and performing songs with chords and backing tracks.",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "vite",
    "electron:dev": "vite",
    "electron:build": "tsc -b && vite build && electron-builder",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@singz/ui": "file:vendor/singz-ui-1.8.2.tgz",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vite-plugin-electron": "1.1.1",
    "vite-plugin-electron-renderer": "1.0.0"
  },
  "build": {
    "appId": "studio.chordz.app",
    "productName": "ChordZ",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": "dmg"
    }
  },
  "allowScripts": {
    "electron@43.4.0": true
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
